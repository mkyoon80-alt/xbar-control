<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XBAR Control" Width="1100" Height="860" MinWidth="900" MinHeight="790"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Workspace}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Workspace" Color="#F1F3F5"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Sidebar" Color="#E9EEF2"/>
    <SolidColorBrush x:Key="Ink" Color="#182731"/>
    <SolidColorBrush x:Key="Muted" Color="#53646E"/>
    <SolidColorBrush x:Key="Accent" Color="#315DCE"/>
    <SolidColorBrush x:Key="Line" Color="#CDD5DC"/>
    <SolidColorBrush x:Key="InputLine" Color="#8B9BA8"/>
    <SolidColorBrush x:Key="Readout" Color="#192F3D"/>
    <SolidColorBrush x:Key="ReadoutMuted" Color="#BDD0DE"/>
    <SolidColorBrush x:Key="PendingInk" Color="#AFC6FF"/>
    <SolidColorBrush x:Key="PendingSurface" Color="#EAF0FF"/>
    <SolidColorBrush x:Key="StatusSurface" Color="#EDF1F5"/>
    <SolidColorBrush x:Key="StatusInk" Color="#405B70"/>
    <SolidColorBrush x:Key="DisabledInk" Color="#657480"/>
    <SolidColorBrush x:Key="DisabledSurface" Color="#E0E5EA"/>
    <SolidColorBrush x:Key="Error" Color="#A53432"/>
    <SolidColorBrush x:Key="Logo" Color="#182E3C"/>
    <SolidColorBrush x:Key="Track" Color="#CBD4DE"/>
    <SolidColorBrush x:Key="ReadoutLine" Color="#405763"/>
    <SolidColorBrush x:Key="ReadoutArrow" Color="#93AEBD"/>
    <SolidColorBrush x:Key="SidebarLine" Color="#C5D0D9"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ReadoutInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LogoInk" Color="#FFFFFF"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Quiet" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/></Style>
    <Style x:Key="Focus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Rectangle Margin="-4" RadiusX="8" RadiusY="8" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeDashArray="2,1"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,10"/><Setter Property="MinHeight" Value="42"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/><Setter TargetName="Frame" Property="Background" Value="{DynamicResource DisabledSurface}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource DisabledSurface}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="12,8"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource InputLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style x:Key="ThemeChoice" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="36"/><Setter Property="MinWidth" Value="66"/><Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Choice" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="12,7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource Line}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource Surface}"/><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="MinHeight" Value="40"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="CheckFrame" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource InputLine}" Background="{DynamicResource Surface}" VerticalAlignment="Center"><Path x:Name="Tick" Data="M 3,8 L 7,12 L 14,4" Stroke="{DynamicResource OnAccent}" StrokeThickness="2" Visibility="Collapsed"/></Border>
        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/>
      </Grid><ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckFrame" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="CheckFrame" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckFrame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
      </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="36"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border CornerRadius="6" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource InputLine}" BorderThickness="1"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Border></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,6,28,6" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource InputLine}" BorderThickness="1" Padding="4"><ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></Border></Popup>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="{DynamicResource Surface}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource PendingSurface}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Expander"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
      <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" Foreground="{DynamicResource Muted}" HorizontalContentAlignment="Left" FocusVisualStyle="{StaticResource Focus}" Cursor="Hand">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent" MinHeight="28"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="Chevron" Data="M 0,0 L 4,4 L 0,8" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/><ContentPresenter Grid.Column="1" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter x:Name="Expanded" Visibility="Collapsed"/>
    </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Expanded" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource InputLine}" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="TrackButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="5" Background="{TemplateBinding Background}" CornerRadius="2"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Slider">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Height="36" Background="Transparent">
          <Track x:Name="PART_Track" Margin="10,0" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource TrackButton}" Background="{DynamicResource Accent}"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="22" Height="28" Cursor="SizeWE"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" CornerRadius="5" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="2"><Grid><Rectangle Width="2" Height="10" Fill="{DynamicResource Accent}"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource PendingSurface}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource TrackButton}" Background="{DynamicResource Track}"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="28,20,28,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="40" Height="40" Background="{DynamicResource Logo}" CornerRadius="9" Margin="0,0,13,0">
          <Viewbox Margin="10"><Path Data="M 0,0 L 20,20 M 20,0 L 0,20 M 0,10 L 20,10" Stroke="{DynamicResource LogoInk}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
        </Border>
        <StackPanel><TextBlock Text="XBAR Control" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="크로스바 클럭 컨트롤 패널" Style="{StaticResource Quiet}" Margin="0,2,0,0"/></StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="{DynamicResource StatusSurface}" CornerRadius="9" Padding="3" Margin="0,0,12,0">
          <StackPanel Orientation="Horizontal" AutomationProperties.Name="화면 테마">
            <RadioButton x:Name="LightTheme" Content="라이트" GroupName="Theme" Style="{StaticResource ThemeChoice}" AutomationProperties.Name="라이트 모드" ToolTip="밝은 화면으로 전환 · 선택 자동 저장"/>
            <RadioButton x:Name="DarkTheme" Content="다크" GroupName="Theme" Style="{StaticResource ThemeChoice}" Margin="2,0,0,0" AutomationProperties.Name="다크 모드" ToolTip="어두운 화면으로 전환 · 선택 자동 저장"/>
          </StackPanel>
        </Border>
        <Button x:Name="RefreshButton" Content="새로고침" ToolTip="GPU에서 현재 값을 다시 읽습니다. F5"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
          <TextBlock x:Name="GpuName" Text="NVIDIA GPU 검색 중…" FontSize="17" FontWeight="SemiBold"/>
          <ComboBox x:Name="GpuSelector" Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.Name="제어할 NVIDIA GPU"/>
          <WrapPanel Margin="0,5,0,0"><TextBlock x:Name="DriverText" Text="드라이버 확인 중" Style="{StaticResource Quiet}" Margin="0,0,12,0"/><TextBlock x:Name="BusText" Style="{StaticResource Quiet}"/></WrapPanel>
        </StackPanel>
        <Border Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="20,0,0,0" VerticalAlignment="Center">
          <StackPanel><TextBlock x:Name="ConnectionTitle" Text="상태를 확인하고 있습니다" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionDetail" Text="드라이버와 XBAR 데이터를 읽습니다." Style="{StaticResource Quiet}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
        </Border>
        <Button x:Name="AdminButton" Grid.Column="2" Content="관리자 권한으로 열기" Margin="20,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource Surface}" CornerRadius="12" Padding="24,20">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer x:Name="ManualScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="XBAR 조정" FontSize="19" FontWeight="SemiBold"/>
                <Border Grid.Column="1" x:Name="StateBadge" Background="{DynamicResource StatusSurface}" CornerRadius="5" Padding="10,6" VerticalAlignment="Top"><TextBlock x:Name="StateBadgeText" Text="연결 중" FontSize="12" Foreground="{DynamicResource StatusInk}" FontWeight="SemiBold"/></Border>
              </Grid>
              <Border Background="{DynamicResource Readout}" CornerRadius="10" Padding="18,10">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="현재 적용값 · MHz" FontSize="12" Foreground="{DynamicResource ReadoutMuted}"/>
                  <TextBlock Grid.Column="2" Text="적용할 값 · MHz" FontSize="12" Foreground="{DynamicResource ReadoutMuted}"/>
                  <TextBlock x:Name="CurrentValue" Grid.Row="1" Text="—" FontFamily="Consolas" FontSize="32" Foreground="{DynamicResource ReadoutInk}" Margin="0,6,0,0"/>
                  <Path Grid.Row="1" Grid.Column="1" Data="M 0,6 L 12,6 M 7,1 L 12,6 L 7,11" Stroke="{DynamicResource ReadoutArrow}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                  <TextBlock x:Name="TargetValue" Grid.Row="1" Grid.Column="2" Text="—" FontFamily="Consolas" FontSize="32" Foreground="{DynamicResource PendingInk}" Margin="0,6,0,0"/>
                  <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0" BorderBrush="{DynamicResource ReadoutLine}" BorderThickness="0,1,0,0" Padding="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="실측 XBAR 클럭" Foreground="{DynamicResource ReadoutMuted}" FontSize="12"/><TextBlock x:Name="PhysicalClock" Grid.Column="1" Text="읽는 중…" Foreground="{DynamicResource ReadoutInk}" FontFamily="Consolas" FontSize="14"/></Grid></Border>
                </Grid>
              </Border>
              <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="오프셋 · MHz" FontWeight="SemiBold"/><TextBlock x:Name="DeltaText" Grid.Column="1" Text="현재 값 확인 중" Style="{StaticResource Quiet}" HorizontalAlignment="Right" Margin="12,0,0,0"/></Grid>
              <Slider x:Name="OffsetSlider" Minimum="-300" Maximum="500" TickFrequency="1" SmallChange="1" LargeChange="15" IsSnapToTickEnabled="True" Margin="0,8,0,0" IsEnabled="False" AutomationProperties.Name="XBAR 오프셋 조정"/>
              <Grid Margin="0,0,0,10"><TextBlock x:Name="RangeMin" Text="−300" Style="{StaticResource Quiet}"/><TextBlock x:Name="RangeMax" Text="+500" Style="{StaticResource Quiet}" HorizontalAlignment="Right"/></Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                <Button x:Name="MinusButton" Content="−15" AutomationProperties.Name="XBAR 조정값 15 MHz 낮추기" IsEnabled="False"/>
                <Grid Grid.Column="2"><TextBox x:Name="OffsetInput" Text="" IsEnabled="False" AutomationProperties.Name="XBAR 오프셋 MHz 직접 입력" FontFamily="Consolas" FontSize="18" TextAlignment="Center" Padding="30,8"/><TextBlock Text="MHz" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,10,0"/></Grid>
                <Button x:Name="PlusButton" Grid.Column="4" Content="+15" AutomationProperties.Name="XBAR 조정값 15 MHz 높이기" IsEnabled="False"/>
              </Grid>
              <TextBlock x:Name="InputHint" Text="1 MHz 단위로 입력 · 버튼으로 15 MHz씩 조정" Style="{StaticResource Quiet}" Margin="0,7,0,0"/>
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="ApplyStatus" Grid.ColumnSpan="2" Text="GPU 연결 중" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <StackPanel Grid.Row="1" Orientation="Horizontal"><Button x:Name="ResetButton" Content="리셋" MinWidth="78" IsEnabled="False" ToolTip="오프셋을 0 MHz로 준비합니다. XBAR 적용을 누르면 반영됩니다."/><TextBlock Text="0 MHz 준비" Style="{StaticResource Quiet}" VerticalAlignment="Center" Margin="10,0,12,0"/></StackPanel>
              <Button x:Name="ApplyButton" Grid.Row="1" Grid.Column="1" Content="XBAR 적용" Style="{StaticResource Primary}" MinWidth="132" MinHeight="46" IsEnabled="False"/>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource Sidebar}" CornerRadius="12" Padding="22">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
              <TextBlock Text="시작 시 자동 적용" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Text="저장한 값을 다음 시작에 사용합니다" Style="{StaticResource Quiet}" Margin="0,4,0,0"/>
              <Grid Margin="0,20,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="저장된 자동 적용값" Style="{StaticResource Quiet}" VerticalAlignment="Center"/><TextBlock x:Name="SavedStartupValue" Grid.Column="1" Text="미저장" FontFamily="Consolas, Malgun Gothic" FontSize="23"/></Grid>
              <Button x:Name="SaveStartupButton" Content="자동 적용값 저장" ToolTip="GPU에 현재 적용된 값을 자동 적용용으로 저장합니다. 입력 중인 값은 먼저 XBAR 적용을 눌러 주세요."/>
              <TextBlock x:Name="SaveStartupHint" Style="{StaticResource Quiet}" Margin="0,8,0,0"/>
              <Border BorderBrush="{DynamicResource SidebarLine}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,18,0,0">
                <StackPanel>
                  <CheckBox x:Name="AppStartCheck" Content="앱 실행 시 적용" AutomationProperties.Name="앱 실행 시 저장된 XBAR 값 자동 적용"/>
                  <CheckBox x:Name="WindowsStartCheck" AutomationProperties.Name="Windows 로그인 30초 후 실행하고 저장된 XBAR 값 적용" MinHeight="58"><StackPanel><TextBlock Text="Windows 시작 시 적용"/><TextBlock Text="로그인 30초 후 앱 실행" Style="{StaticResource Quiet}" Margin="0,3,0,0"/></StackPanel></CheckBox>
                  <CheckBox x:Name="TrayStartCheck" Content="트레이 아이콘으로 시작" Margin="28,0,0,0" AutomationProperties.Name="Windows 시작 시 창 대신 트레이 아이콘으로 실행" ToolTip="Windows 시작 시 적용을 켠 뒤 선택하세요. 트레이 더블클릭으로 창을 열고, 우클릭 메뉴에서 자동 적용 취소 또는 종료할 수 있습니다."/>
                  <TextBlock Text="앱 실행 후 5초 동안 취소할 수 있습니다." Style="{StaticResource Quiet}" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="StartupPermission" Style="{StaticResource Quiet}" Margin="0,6,0,0"/>
              <Expander x:Name="CompatibilityExpander" Header="저장 정보 · 연결 상세 · 최근 기록" FontSize="12" Margin="0,18,0,0">
                <StackPanel Margin="0,10,0,0">
